# GXC-CORE mainnet configuration
#
# Copy to gxc.conf and pass with:  gxc-node --config config/gxc.conf
#
# Format is `key=value`, one per line. Lines starting with # are comments.
# The keys below are exactly the keys the node reads (see src/Config.cpp);
# an unrecognized key is stored but never consulted, so a typo is silent.
# Values shown are the built-in defaults.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Select the network. Setting this to true also shifts the default ports to
# their testnet equivalents (19333 / 18332 / 18080).
testnet=false

network_port=9333
rpc_port=8332
rest_port=8080

max_connections=100
max_peers=20
min_peers=8
connection_timeout=30

# Peer banning: `ban_threshold` misbehaviour strikes results in a ban lasting
# `ban_duration` seconds.
ban_threshold=10
ban_duration=86400

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

data_dir=./gxc_data
wallet_file=wallet.dat
wallet_backup_interval=3600

# LevelDB block cache, in bytes (256 MiB).
cache_size=268435456

# Compaction and checkpoint cadence.
vacuum_interval=604800
checkpoint_interval=1000

# ---------------------------------------------------------------------------
# Consensus
# ---------------------------------------------------------------------------

target_block_time=600
difficulty_adjustment_interval=10
block_reward=50.0
max_block_size=1048576
min_confirmations=6

# ---------------------------------------------------------------------------
# Proof of Traceability
# ---------------------------------------------------------------------------

# Enforce POT on incoming transactions. Turning this off disables the chain of
# custody the protocol exists to provide; leave it on unless you are debugging.
enable_traceability=true

# `strict` rejects any transaction whose declared ancestor and amount do not
# match its first input.
traceability_validation=strict

# How far back a traceability query will walk before giving up.
trace_depth_limit=10000

# ---------------------------------------------------------------------------
# Mining
# ---------------------------------------------------------------------------

enable_mining=false

# One of: SHA256, ETHASH, GXHASH.
mining_algorithm=GXHASH
mining_threads=1

# Address that receives block rewards. Required when enable_mining=true.
miner_address=

# Stratum pool address, if mining to a pool rather than solo.
pool_address=

# ---------------------------------------------------------------------------
# Fees
# ---------------------------------------------------------------------------

transaction_fee=0.001
base_transaction_fee=0.001
min_tx_fee=0.001
max_transaction_fee=0.01
mempool_size=50000000

# Dynamic fees scale with mempool pressure: once the pending count crosses a
# threshold, the corresponding multiplier applies to the base fee.
enable_dynamic_fees=true
fee_low_threshold=10
fee_low_multiplier=1.0
fee_medium_threshold=50
fee_medium_multiplier=1.5
fee_high_threshold=100
fee_high_multiplier=2.0
fee_very_high_multiplier=3.0

# ---------------------------------------------------------------------------
# APIs
# ---------------------------------------------------------------------------

enable_rpc_api=true
enable_rest_api=true

# Requests per minute, per client.
api_rate_limit=100

# Leave api_key empty to disable API authentication. Do not do that on a host
# reachable from the internet.
api_key=

enable_ssl=false
ssl_cert_file=
ssl_key_file=

# ---------------------------------------------------------------------------
# Governance
# ---------------------------------------------------------------------------

governance_enabled=true

# Deposit required to submit a proposal, in GXC.
proposal_deposit=100.0

# Fraction of staked supply that must vote for a proposal to be decidable.
quorum_threshold=0.33

# Voting window, in seconds (7 days).
voting_period=604800

# ---------------------------------------------------------------------------
# Cross-chain bridge
# ---------------------------------------------------------------------------

bridge_enabled=false

# A transfer needs `bridge_threshold` of `bridge_validators` signatures.
bridge_validators=3
bridge_threshold=2

# ---------------------------------------------------------------------------
# Logging and diagnostics
# ---------------------------------------------------------------------------

# One of: TRACE, DEBUG, INFO, WARNING, ERROR.
log_level=INFO
log_file=gxc.log
log_to_console=true
log_max_size=10485760
log_max_files=5

debug_mode=false
enable_profiling=false
stats_interval=300
